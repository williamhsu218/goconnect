+package process
+
+import (
+	"testing"
+)
+
+type gcTestReader struct {
+	processes       map[uint32]goConnectProcess
+	signatures      map[uint32]goConnectSignature
+	reads, signs    map[uint32]int
+	change          func(*goConnectProcess, int)
+	changeSignature func(*goConnectSignature, int)
+}
+
+func (r *gcTestReader) Snapshot(pid uint32) (goConnectProcess, bool) {
+	n, ok := r.processes[pid]
+	r.reads[pid]++
+	if r.change != nil {
+		r.change(&n, r.reads[pid])
+	}
+	return n, ok
+}
+func (r *gcTestReader) Signature(pid uint32) (goConnectSignature, bool) {
+	s, ok := r.signatures[pid]
+	r.signs[pid]++
+	if r.changeSignature != nil {
+		r.changeSignature(&s, r.signs[pid])
+	}
+	return s, ok
+}
+func gcPolicyFixture() (*GoConnectAppPolicy, *gcTestReader) {
+	r := &gcTestReader{processes: map[uint32]goConnectProcess{
+		20: {PID: 20, Parent: 10, UID: 501, Started: 200, Path: "/opt/vendor/cli"},
+		10: {PID: 10, Parent: 1, UID: 501, Started: 100, Path: "/Applications/Allowed.app/Contents/MacOS/Allowed"},
+	}, signatures: map[uint32]goConnectSignature{20: {Team: "A", ID: "cli", Hash: "child-hash"}, 10: {Team: "A", ID: "com.example.allowed", Hash: "parent-hash"}}, reads: map[uint32]int{}, signs: map[uint32]int{}}
+	return &GoConnectAppPolicy{app: "/Applications/Allowed.app", home: "/Users/test", uid: 501, reader: r}, r
+}
+func TestGoConnectAppPolicySignedLiveChildAndPrivateVendorCLI(t *testing.T) {
+	p, r := gcPolicyFixture()
+	if !p.Match(20, r.processes[20].Path) {
+		t.Fatal("signed same-team live child rejected")
+	}
+	p, r = gcPolicyFixture()
+	n := r.processes[20]
+	n.Path = "/Users/test/Library/Application Support/Allowed/versions/2/cli.app/Contents/MacOS/cli"
+	r.processes[20] = n
+	s := r.signatures[20]
+	s.Team = "OTHER"
+	r.signatures[20] = s
+	if !p.Match(20, n.Path) {
+		t.Fatal("signed private installed CLI rejected")
+	}
+}
+func TestGoConnectAppPolicyBoundaries(t *testing.T) {
+	for _, name := range []string{"different-child-uid", "different-parent-uid", "not-descendant", "other-team", "unsigned", "other-app", "shell", "interpreter", "system-tool", "shared-intermediate", "parent-newer", "cycle", "root-prefix-spoof", "metadata-path-mismatch", "root-process"} {
+		t.Run(name, func(t *testing.T) {
+			p, r := gcPolicyFixture()
+			n := r.processes[20]
+			root := r.processes[10]
+			expected := n.Path
+			pid := uint32(20)
+			switch name {
+			case "different-child-uid":
+				n.UID = 502
+			case "different-parent-uid":
+				root.UID = 502
+			case "not-descendant":
+				n.Parent = 1
+			case "other-team":
+				s := r.signatures[20]
+				s.Team = "B"
+				r.signatures[20] = s
+			case "unsigned":
+				delete(r.signatures, 20)
+			case "other-app":
+				n.Path = "/Applications/Other.app/Contents/MacOS/Other"
+				expected = n.Path
+			case "shell":
+				n.Path = "/opt/homebrew/bin/zsh"
+				expected = n.Path
+			case "interpreter":
+				n.Path = "/opt/homebrew/bin/python3.14"
+				expected = n.Path
+			case "system-tool":
+				n.Path = "/usr/bin/curl"
+				expected = n.Path
+			case "shared-intermediate":
+				n.Parent = 15
+				r.processes[15] = goConnectProcess{PID: 15, Parent: 10, UID: 501, Started: 150, Path: "/opt/homebrew/bin/node"}
+			case "parent-newer":
+				root.Started = 300
+			case "cycle":
+				n.Parent = 20
+			case "root-prefix-spoof":
+				root.Path = "/Applications/Allowed.app.evil/Contents/MacOS/Allowed"
+			case "metadata-path-mismatch":
+				expected = "/opt/vendor/other-cli"
+			case "root-process":
+				pid = 10
+				expected = root.Path
+			}
+			r.processes[20] = n
+			r.processes[10] = root
+			if p.Match(pid, expected) {
+				t.Fatal("unrelated or unverifiable process inherited")
+			}
+		})
+	}
+}
+func TestGoConnectAppPolicyRechecksIdentityWithoutGlobalPIDGrant(t *testing.T) {
+	for _, name := range []string{"pid-reuse", "exec", "reparent", "uid-change", "code-change"} {
+		t.Run(name, func(t *testing.T) {
+			p, r := gcPolicyFixture()
+			r.change = func(n *goConnectProcess, reads int) {
+				if reads < 2 {
+					return
+				}
+				switch name {
+				case "pid-reuse":
+					n.Started++
+				case "exec":
+					n.Executable[0]++
+				case "reparent":
+					n.Parent = 1
+				case "uid-change":
+					n.UID = 502
+				}
+			}
+			if name == "code-change" {
+				r.changeSignature = func(s *goConnectSignature, reads int) {
+					if reads >= 2 {
+						s.Hash = "changed"
+					}
+				}
+			}
+			if p.Match(20, r.processes[20].Path) {
+				t.Fatal("identity race was accepted")
+			}
+		})
+	}
+	p, r := gcPolicyFixture()
+	if !p.Match(20, r.processes[20].Path) {
+		t.Fatal("initial child rejected")
+	}
+	n := r.processes[20]
+	n.Parent = 1
+	r.processes[20] = n
+	if p.Match(20, n.Path) {
+		t.Fatal("a prior match became a persistent PID/path grant")
+	}
+}
