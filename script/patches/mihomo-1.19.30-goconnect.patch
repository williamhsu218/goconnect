+//go:build darwin && cgo
+
+package process
+
+/*
+#cgo LDFLAGS: -framework Security -framework CoreFoundation
+#include <libproc.h>
+#include <sys/proc_info.h>
+#include <sys/resource.h>
+#include <Security/Security.h>
+#include <CoreFoundation/CoreFoundation.h>
+#include <string.h>
+
+static int gc_snapshot(int pid, unsigned int *parent, unsigned int *uid,
+                       unsigned long long *started, unsigned char *uuid, char *path, int capacity) {
+    struct proc_bsdinfo a = {0}, b = {0};
+    struct rusage_info_v2 usage = {0};
+    if (proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, &a, sizeof(a)) != sizeof(a) ||
+        proc_pidpath(pid, path, capacity) <= 0 ||
+        proc_pid_rusage(pid, RUSAGE_INFO_V2, (rusage_info_t *)&usage) != 0 ||
+        proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, &b, sizeof(b)) != sizeof(b) ||
+        a.pbi_pid != pid || a.pbi_pid != b.pbi_pid || a.pbi_ppid != b.pbi_ppid ||
+        a.pbi_uid != b.pbi_uid || a.pbi_ruid != a.pbi_uid || a.pbi_svuid != a.pbi_uid ||
+        a.pbi_uid != b.pbi_ruid || a.pbi_uid != b.pbi_svuid ||
+        a.pbi_start_tvsec != b.pbi_start_tvsec || a.pbi_start_tvusec != b.pbi_start_tvusec ||
+        a.pbi_status == 5 || b.pbi_status == 5) return -1;
+    *parent = a.pbi_ppid; *uid = a.pbi_uid;
+    *started = a.pbi_start_tvsec * 1000000ULL + a.pbi_start_tvusec;
+    memcpy(uuid, usage.ri_uuid, 16);
+    return 0;
+}
+static int gc_string(CFDictionaryRef info, CFStringRef key, char *out, int size) {
+    CFTypeRef value = CFDictionaryGetValue(info, key);
+    return value && CFGetTypeID(value) == CFStringGetTypeID() &&
+        CFStringGetCString((CFStringRef)value, out, size, kCFStringEncodingUTF8) && out[0];
+}
+static int gc_signature(int pid, char *team, int teamSize, char *identifier, int identifierSize,
+                        unsigned char *hash, int *hashSize) {
+    SecCodeRef guest = NULL;
+    SecRequirementRef requirement = NULL;
+    CFDictionaryRef info = NULL;
+    CFNumberRef number = CFNumberCreate(NULL, kCFNumberIntType, &pid);
+    const void *keys[] = { kSecGuestAttributePid };
+    const void *values[] = { number };
+    CFDictionaryRef attrs = CFDictionaryCreate(NULL, keys, values, 1,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    OSStatus status = SecCodeCopyGuestWithAttributes(NULL, attrs, kSecCSDefaultFlags, &guest);
+    if (!status) status = SecRequirementCreateWithString(CFSTR("anchor apple generic"), kSecCSDefaultFlags, &requirement);
+    if (!status) status = SecCodeCheckValidity(guest, kSecCSStrictValidate, requirement);
+    if (!status) status = SecCodeCopySigningInformation(guest, kSecCSSigningInformation, &info);
+    if (!status && (!gc_string(info, kSecCodeInfoTeamIdentifier, team, teamSize) ||
+                    !gc_string(info, kSecCodeInfoIdentifier, identifier, identifierSize))) status = -1;
+    if (!status) {
+        CFDataRef digest = (CFDataRef)CFDictionaryGetValue(info, kSecCodeInfoUnique);
+        if (!digest || CFGetTypeID(digest) != CFDataGetTypeID() ||
+            CFDataGetLength(digest) < 16 || CFDataGetLength(digest) > *hashSize) status = -1;
+        else { *hashSize = (int)CFDataGetLength(digest); memcpy(hash, CFDataGetBytePtr(digest), *hashSize); }
+    }
+    if (info) CFRelease(info);
+    if (requirement) CFRelease(requirement);
+    if (guest) CFRelease(guest);
+    CFRelease(attrs); CFRelease(number);
+    return status;
+}
+*/
+import "C"
+
+import (
+	"encoding/binary"
+	"encoding/hex"
+	"golang.org/x/sys/unix"
+	"net/netip"
+	"unsafe"
+)
+
+type goConnectDarwinReader struct{}
+
+func init() {
+	goConnectNativeReader = goConnectDarwinReader{}
+	goConnectSocketLookup = goConnectDarwinSocketPID
+}
+func (goConnectDarwinReader) Snapshot(pid uint32) (goConnectProcess, bool) {
+	var parent, uid C.uint
+	var started C.ulonglong
+	var uuid [16]byte
+	var path [4096]C.char
+	if C.gc_snapshot(C.int(pid), &parent, &uid, &started, (*C.uchar)(unsafe.Pointer(&uuid[0])), &path[0], C.int(len(path))) != 0 {
+		return goConnectProcess{}, false
+	}
+	return goConnectProcess{PID: pid, Parent: uint32(parent), UID: uint32(uid), Started: uint64(started), Executable: uuid, Path: C.GoString(&path[0])}, true
+}
+func (goConnectDarwinReader) Signature(pid uint32) (goConnectSignature, bool) {
+	var team [128]C.char
+	var identifier [1024]C.char
+	var hash [64]byte
+	size := C.int(len(hash))
+	if C.gc_signature(C.int(pid), &team[0], C.int(len(team)), &identifier[0], C.int(len(identifier)), (*C.uchar)(unsafe.Pointer(&hash[0])), &size) != 0 {
+		return goConnectSignature{}, false
+	}
+	return goConnectSignature{Team: C.GoString(&team[0]), ID: C.GoString(&identifier[0]), Hash: hex.EncodeToString(hash[:int(size)])}, true
+}
+
+func goConnectDarwinSocketPID(network string, ip netip.Addr, port int) (uint32, bool) {
+	name := "net.inet.tcp.pcblist_n"
+	size := structSize + 208
+	if network == UDP {
+		name = "net.inet.udp.pcblist_n"
+		size = structSize
+	} else if network != TCP {
+		return 0, false
+	}
+	buf, err := unix.SysctlRaw(name)
+	if err != nil {
+		return 0, false
+	}
+	exact, wildcard := map[uint32]bool{}, map[uint32]bool{}
+	for i := 24; i+size <= len(buf); i += size {
+		if int(binary.BigEndian.Uint16(buf[i+18:i+20])) != port {
+			continue
+		}
+		flag := buf[i+44]
+		var source netip.Addr
+		if flag&1 != 0 && ip.Is4() {
+			source, _ = netip.AddrFromSlice(buf[i+76 : i+80])
+		} else if flag&2 != 0 && !ip.Is4() {
+			source, _ = netip.AddrFromSlice(buf[i+64 : i+80])
+		} else {
+			continue
+		}
+		pid := readNativeUint32(buf[i+104+68 : i+104+72])
+		if source.Unmap() == ip.Unmap() {
+			exact[pid] = true
+		} else if network == UDP && source.IsUnspecified() {
+			wildcard[pid] = true
+		}
+	}
+	candidates := exact
+	if len(candidates) == 0 {
+		candidates = wildcard
+	}
+	if len(candidates) == 1 {
+		for pid := range candidates {
+			return pid, pid > 1
+		}
+	}
+	return 0, false
+}
