+//go:build darwin && cgo
+
+package process
+
+import (
+	"net"
+	"net/netip"
+	"os"
+	"strconv"
+	"testing"
+)
+
+func TestGoConnectNativeSocketOwnership(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	client, err := net.Dial("tcp4", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	server, err := listener.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	a := client.LocalAddr().(*net.TCPAddr)
+	pid := GoConnectSocketPID(TCP, netip.MustParseAddr(a.IP.String()), a.Port)
+	if pid != uint32(os.Getpid()) {
+		t.Fatalf("socket owner %d, want own PID %d", pid, os.Getpid())
+	}
+	if GoConnectSocketPID("invalid", netip.MustParseAddr("127.0.0.1"), a.Port) != 0 {
+		t.Fatal("unsupported protocol inherited")
+	}
+}
+
+func TestGoConnectNativeCurrentAppChild(t *testing.T) {
+	value := os.Getenv("GOCONNECT_NATIVE_CHILD_PID")
+	if value == "" {
+		t.Skip("explicit read-only live child check not requested")
+	}
+	pid, err := strconv.ParseUint(value, 10, 32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	n, ok := goConnectNativeReader.Snapshot(uint32(pid))
+	if !ok {
+		t.Fatal("cannot read child identity")
+	}
+	p, err := NewGoConnectAppPolicy(os.Getenv("GOCONNECT_NATIVE_CHILD_APP"), uint32(os.Getuid()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !p.Match(uint32(pid), n.Path) {
+		t.Fatal("current signed live App child did not match")
+	}
+	other, err := NewGoConnectAppPolicy("/Applications/Unrelated.app", uint32(os.Getuid()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if other.Match(uint32(pid), n.Path) {
+		t.Fatal("child matched unrelated App")
+	}
+	t.Log("live external child, UID, signatures and launch chain verified; unrelated App rejected")
+}
