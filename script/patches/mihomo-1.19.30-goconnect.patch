+package process
+
+import (
+	"errors"
+	"net/netip"
+	"os/user"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+// No global PID/path allowlist: every new flow verifies its own live launch chain.
+type goConnectProcess struct {
+	PID, Parent, UID uint32
+	Started          uint64
+	Executable       [16]byte
+	Path             string
+}
+
+type goConnectSignature struct{ Team, ID, Hash string }
+type goConnectProcessReader interface {
+	Snapshot(uint32) (goConnectProcess, bool)
+	Signature(uint32) (goConnectSignature, bool)
+}
+
+var goConnectNativeReader goConnectProcessReader
+var goConnectSocketLookup func(string, netip.Addr, int) (uint32, bool)
+
+func GoConnectSocketPID(network string, ip netip.Addr, port int) uint32 {
+	if goConnectSocketLookup != nil {
+		if pid, ok := goConnectSocketLookup(network, ip, port); ok {
+			return pid
+		}
+	}
+	return 0
+}
+
+type GoConnectAppPolicy struct {
+	app, home string
+	uid       uint32
+	reader    goConnectProcessReader
+}
+
+func NewGoConnectAppPolicy(app string, uid uint32) (*GoConnectAppPolicy, error) {
+	if uid == 0 || !filepath.IsAbs(app) || filepath.Clean(app) != app ||
+		!strings.EqualFold(filepath.Ext(app), ".app") || strings.ContainsAny(app, ",\x00\r\n") {
+		return nil, errors.New("invalid GoConnect application child policy")
+	}
+	owner, err := user.LookupId(strconv.FormatUint(uint64(uid), 10))
+	if err != nil || !filepath.IsAbs(owner.HomeDir) {
+		return nil, errors.New("GoConnect owner unavailable")
+	}
+	return &GoConnectAppPolicy{app: app, home: owner.HomeDir, uid: uid, reader: goConnectNativeReader}, nil
+}
+
+func within(path, root string) bool { return strings.HasPrefix(path, root+string(filepath.Separator)) }
+
+func (p *GoConnectAppPolicy) privatePath(path, bundleID string) bool {
+	name := strings.TrimSuffix(filepath.Base(p.app), filepath.Ext(p.app))
+	for _, folder := range []string{"Application Support", "Caches"} {
+		for _, component := range []string{name, bundleID} {
+			if component != "" && component != "." && component != ".." && !strings.ContainsAny(component, "/\\") &&
+				within(path, filepath.Join(p.home, "Library", folder, component)) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (p *GoConnectAppPolicy) boundary(path string) bool {
+	// Never inherit through system tools, shared shells/runtimes or another App.
+	for _, prefix := range []string{"/System", "/bin", "/sbin", "/usr/bin", "/usr/sbin", "/usr/libexec"} {
+		if within(path, prefix) {
+			return true
+		}
+	}
+	base := strings.ToLower(filepath.Base(path))
+	for _, name := range []string{"sh", "bash", "zsh", "fish", "dash", "node", "nodejs", "ruby", "perl", "osascript", "open", "login", "env", "java", "dotnet", "deno", "bun"} {
+		if base == name {
+			return true
+		}
+	}
+	if strings.HasPrefix(base, "python") {
+		return true
+	}
+	if strings.Contains(strings.ToLower(path), ".app/contents/") && !p.privatePath(path, "") {
+		return true
+	}
+	return false
+}
+
+func (p *GoConnectAppPolicy) Match(pid uint32, expectedPath string) bool {
+	if p.reader == nil || pid <= 1 || expectedPath == "" {
+		return false
+	}
+	chain := make([]goConnectProcess, 0, 8)
+	seen := map[uint32]bool{}
+	for len(chain) < 12 && pid > 1 && !seen[pid] {
+		seen[pid] = true
+		node, ok := p.reader.Snapshot(pid)
+		if !ok || node.PID != pid || node.UID != p.uid || node.Started == 0 || !filepath.IsAbs(node.Path) || filepath.Clean(node.Path) != node.Path {
+			return false
+		}
+		if len(chain) == 0 && node.Path != expectedPath {
+			return false
+		}
+		if len(chain) > 0 && node.Started > chain[len(chain)-1].Started {
+			return false
+		}
+		chain = append(chain, node)
+		if within(node.Path, p.app) {
+			// An in-bundle process already matches the existing path rule.
+			if len(chain) == 1 {
+				return false
+			}
+			anchor, ok := p.reader.Signature(pid)
+			if !ok || anchor.Team == "" || anchor.Hash == "" {
+				return false
+			}
+			signatures := make([]goConnectSignature, len(chain))
+			signatures[len(chain)-1] = anchor
+			for i, child := range chain[:len(chain)-1] {
+				sig, valid := p.reader.Signature(child.PID)
+				if !valid || sig.Team == "" || sig.Hash == "" || (sig.Team != anchor.Team && !p.privatePath(child.Path, anchor.ID)) {
+					return false
+				}
+				signatures[i] = sig
+			}
+			// Reject exit, PID reuse, reparenting and exec/signature changes during verification.
+			for i, old := range chain {
+				fresh, valid := p.reader.Snapshot(old.PID)
+				if !valid || fresh != old {
+					return false
+				}
+				sig, valid := p.reader.Signature(old.PID)
+				if !valid || sig != signatures[i] {
+					return false
+				}
+			}
+			return true
+		}
+		if p.boundary(node.Path) {
+			return false
+		}
+		pid = node.Parent
+	}
+	return false
+}
