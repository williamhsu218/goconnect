@@ -0,0 +1,91 @@
+package tunnel
+
+import (
+	"context"
+	"errors"
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/miekg/dns"
+	"net/netip"
+	"testing"
+)
+
+type goConnectTestResolver struct {
+	fail  bool
+	calls int
+}
+
+func (r *goConnectTestResolver) LookupIP(context.Context, string) ([]netip.Addr, error) {
+	r.calls++
+	if r.fail {
+		return nil, errors.New("synthetic DNS failure")
+	}
+	return []netip.Addr{netip.MustParseAddr("192.0.2.42")}, nil
+}
+func (r *goConnectTestResolver) LookupIPv4(c context.Context, h string) ([]netip.Addr, error) {
+	return r.LookupIP(c, h)
+}
+func (r *goConnectTestResolver) LookupIPv6(c context.Context, h string) ([]netip.Addr, error) {
+	return r.LookupIP(c, h)
+}
+func (r *goConnectTestResolver) ResolveECH(context.Context, string) ([]byte, error) { return nil, nil }
+func (r *goConnectTestResolver) ExchangeContext(context.Context, *dns.Msg) (*dns.Msg, error) {
+	return nil, nil
+}
+func (r *goConnectTestResolver) Invalid() bool    { return true }
+func (r *goConnectTestResolver) ClearCache()      {}
+func (r *goConnectTestResolver) ResetConnection() {}
+func TestGoConnectRuleResolverSelection(t *testing.T) {
+	oldD, oldN := resolver.DefaultResolver, resolver.DirectHostResolver
+	defer func() { resolver.DefaultResolver, resolver.DirectHostResolver = oldD, oldN }()
+	proxy, native := &goConnectTestResolver{}, &goConnectTestResolver{}
+	resolver.DefaultResolver, resolver.DirectHostResolver = proxy, native
+	if r, ok := goConnectRuleResolver("goconnect-proxy-addresses"); !ok || r != proxy {
+		t.Fatal("proxy DNS boundary")
+	}
+	if r, ok := goConnectRuleResolver("goconnect-native-addresses"); !ok || r != native {
+		t.Fatal("native DNS boundary")
+	}
+	if _, ok := goConnectRuleResolver("ordinary-user-rules"); ok {
+		t.Fatal("ordinary configurations opted in")
+	}
+}
+func TestGoConnectRuleResolverNeverUsesSystemFallback(t *testing.T) {
+	old := resolver.SystemResolver
+	fallback := &goConnectTestResolver{}
+	resolver.SystemResolver = fallback
+	defer func() { resolver.SystemResolver = old }()
+	if _, err := resolveGoConnectRuleIP(context.Background(), "service.example", nil); err == nil {
+		t.Fatal("missing resolver accepted")
+	}
+	failed := &goConnectTestResolver{fail: true}
+	if _, err := resolveGoConnectRuleIP(context.Background(), "service.example", failed); err == nil {
+		t.Fatal("failed resolver accepted")
+	}
+	if fallback.calls != 0 {
+		t.Fatal("DNS failure escaped to system resolver")
+	}
+}
+
+func TestGoConnectUDPDestinationKey(t *testing.T) {
+	old := subRules
+	defer func() { subRules = old }()
+	a := &C.Metadata{DstIP: netip.MustParseAddr("192.0.2.1"), DstPort: 443}
+	b := &C.Metadata{DstIP: netip.MustParseAddr("192.0.2.2"), DstPort: 443}
+	subRules = nil
+	if goConnectUDPKey("source", a) != "source" {
+		t.Fatal("ordinary UDP changed")
+	}
+	subRules = map[string][]C.Rule{"goconnect-udp-destinations": nil}
+	if goConnectUDPKey("source", a) == goConnectUDPKey("source", b) {
+		t.Fatal("destinations share policy")
+	}
+	if goConnectUDPKey("source", a) != goConnectUDPKey("source", a) {
+		t.Fatal("same target mapping unstable")
+	}
+	b.DstIP = a.DstIP
+	b.DstPort = 8443
+	if goConnectUDPKey("source", a) == goConnectUDPKey("source", b) {
+		t.Fatal("destination ports share policy")
+	}
+}
