+package tunnel
+
+import (
+	"context"
+	"errors"
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+	"net/netip"
+)
+
+// Only GoConnect's reserved, process-selected sub-rules opt into this resolver
+// selection. Ordinary Mihomo configurations retain upstream behavior.
+func goConnectRuleResolver(scope string) (resolver.Resolver, bool) {
+	switch scope {
+	case "goconnect-native-addresses":
+		return resolver.DirectHostResolver, true
+	case "goconnect-proxy-addresses":
+		return resolver.DefaultResolver, true
+	default:
+		return nil, false
+	}
+}
+func resolveGoConnectRuleIP(ctx context.Context, host string, r resolver.Resolver) (netip.Addr, error) {
+	// Unlike the general resolver API, never fall back to the OS resolver when
+	// an expected policy resolver is missing, disabled or fails.
+	if r == nil || !r.Invalid() {
+		return netip.Addr{}, errors.New("GoConnect policy resolver unavailable")
+	}
+	return resolver.ResolveIPWithResolver(ctx, host, r)
+}
+
+// Only GoConnect's explicit marker changes upstream source-only UDP NAT keys.
+// Each destination must pass rule matching, including a blocked company gate.
+func goConnectUDPKey(key string, metadata *C.Metadata) string {
+	configMux.RLock()
+	_, enabled := subRules["goconnect-udp-destinations"]
+	configMux.RUnlock()
+	if enabled {
+		return key + "|" + metadata.RemoteAddress()
+	}
+	return key
+}
