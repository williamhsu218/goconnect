+package common
+
+import (
+	"errors"
+	"github.com/metacubex/mihomo/component/process"
+	C "github.com/metacubex/mihomo/constant"
+	"strconv"
+)
+
+type GoConnectAppChild struct {
+	Base
+	app, adapter string
+	policy       *process.GoConnectAppPolicy
+}
+
+func (r *GoConnectAppChild) Payload() string      { return r.app }
+func (r *GoConnectAppChild) Adapter() string      { return r.adapter }
+func (r *GoConnectAppChild) RuleType() C.RuleType { return C.GoConnectAppChild }
+func (r *GoConnectAppChild) Match(m *C.Metadata, helper C.RuleMatchHelper) (bool, string) {
+	if helper.FindProcess != nil {
+		helper.FindProcess()
+	}
+	if !m.GoConnectPIDChecked {
+		m.GoConnectPIDChecked = true
+		m.GoConnectPID = process.GoConnectSocketPID(m.NetWork.String(), m.SrcIP, int(m.SrcPort))
+	}
+	return r.policy.Match(m.GoConnectPID, m.ProcessPath), r.adapter
+}
+func NewGoConnectAppChild(app, adapter string, params []string) (*GoConnectAppChild, error) {
+	if len(params) != 1 {
+		return nil, errors.New("GoConnect App child rule requires session owner UID")
+	}
+	uid, err := strconv.ParseUint(params[0], 10, 32)
+	if err != nil {
+		return nil, err
+	}
+	policy, err := process.NewGoConnectAppPolicy(app, uint32(uid))
+	if err != nil {
+		return nil, err
+	}
+	return &GoConnectAppChild{app: app, adapter: adapter, policy: policy}, nil
+}
